<?xml version="1.0" encoding="UTF-8"?>
<!--
  TODO(lab40): Merge this <profile> into java-bootcamp/examples/lab40-crm/pom.xml <profiles>.
  TODO(lab40): Add property <dependency-check.version>10.0.4</dependency-check.version> (course pin).
  TODO(lab40): Do NOT put nvdApiKey in this file. Pass -DnvdApiKey from env.
  TODO(lab40): Do NOT lower failBuildOnCVSS silently to force green.
-->
<profile>
  <id>security-scan</id>
  <build>
    <plugins>
      <plugin>
        <groupId>org.owasp</groupId>
        <artifactId>dependency-check-maven</artifactId>
        <version>${dependency-check.version}</version>
        <configuration>
          <formats>
            <format>HTML</format>
            <format>JSON</format>
          </formats>
          <failBuildOnCVSS>7</failBuildOnCVSS>
          <suppressionFile>dependency-check-suppressions.xml</suppressionFile>
          <ossindexAnalyzerEnabled>false</ossindexAnalyzerEnabled>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</profile>
