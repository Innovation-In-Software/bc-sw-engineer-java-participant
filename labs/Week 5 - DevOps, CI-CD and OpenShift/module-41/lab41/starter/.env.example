# Lab 41 — runtime config example
# Copy to .env.local (gitignored). Never commit .env / .env.local.
# Do not docker run --env-file .env.example while CRM_DB_PASSWORD is empty.
#
# Local compose (Lab 37): user crm / password change-me / host crm-postgres.
# Isolated database: crm_lab41.
# Profile docker maps these keys in application-docker.yml.

SPRING_PROFILES_ACTIVE=docker
CRM_DB_HOST=crm-postgres
CRM_DB_PORT=5432
CRM_DB_NAME=crm_lab41
CRM_DB_USER=crm
CRM_DB_PASSWORD=
SERVER_PORT=8080
